# Copy to .env and adjust (never commit .env)

# Server (Render sets PORT automatically)
PORT=3001

# CORS: your Vercel site origin(s), comma-separated — e.g. https://your-app.vercel.app
# If unset, all origins are allowed (fine for local dev; set this on Render for a private deploy).
CLIENT_ORIGIN=

# Optional — real OpenAI text generation (backend-only).
# App falls back to template/mock generators when this is unset OR fails.
# NEVER commit a real key here. .env.example IS checked into git.
# Put real keys in backend/.env (gitignored) for local dev,
# and in Render's Environment dashboard for deploys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
