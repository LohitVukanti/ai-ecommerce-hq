# ============================================================
# AI E-Commerce HQ — backend environment template
# ============================================================
# Copy this file to backend/.env and fill in only the keys you
# want to enable. NEVER commit a real .env file — only this
# template (with blank values) is safe to check in.
#
# Every integration ships with a mock / preview fallback. You
# can run the app with ZERO keys set; everything still works.
# Turn on real integrations one at a time by setting the
# matching ENABLE_REAL_* flag to "true" AND filling its keys.
# ============================================================

# --- Server -------------------------------------------------
PORT=3001
# CORS: your Vercel site origin(s), comma-separated.
# If unset, all origins are allowed (fine for local dev; set
# this on Render for a private deploy).
CLIENT_ORIGIN=

# --- OpenAI text generation (backend-only) ------------------
# Powers: POD concept copy, listing copy, design package
# prompts, opportunity-score narrative.
# Falls back to deterministic templates when missing or failing.
# Costs are billed to your OpenAI API account (separate from a
# ChatGPT subscription).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Informational flag for the integration status page.
# OpenAI text is NOT gated by this flag — it uses the key when
# present. Set to "true" to make the status banner say "live".
ENABLE_REAL_OPENAI=false

# --- Image generation (defaults to OpenAI Images) -----------
# Powers: POST /api/products/:id/generate-artwork-image
# Reuses OPENAI_API_KEY. Set ENABLE_REAL_IMAGE_GENERATION=true
# to opt in to real billed image calls; otherwise an SVG mock
# placeholder is generated locally.
OPENAI_IMAGE_MODEL=gpt-image-1
ENABLE_REAL_IMAGE_GENERATION=false

# --- Printify -----------------------------------------------
# Powers: POST /api/products/:id/create-printify-product
# 1) Create a personal access token: https://printify.com/app/account/api
# 2) Find your shop id at https://printify.com/app/store (or
#    GET /v1/shops.json with your token).
# 3) Set ENABLE_REAL_PRINTIFY=true to opt in.
# Without these, the route returns a deterministic preview-mock
# stub so the rest of the workflow keeps working.
# NEVER auto-publishes; all products are created as drafts.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
ENABLE_REAL_PRINTIFY=false

# --- Etsy ---------------------------------------------------
# Powers: POST /api/products/:id/create-real-etsy-draft
# OAuth v3 + PKCE. After setting client + redirect, visit
# /api/etsy/auth/start in a browser to complete the flow.
# Tokens are persisted to backend/data/etsy_tokens.json
# (gitignored). NEVER auto-publishes; all listings are
# created as drafts.
# Create an app at: https://www.etsy.com/developers/your-apps
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=http://localhost:3001/api/etsy/auth/callback
# Optional: skip the /me lookup by hard-coding your shop id.
ETSY_SHOP_ID=
# These are populated by the OAuth callback handler — do NOT
# fill them by hand.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ENABLE_REAL_ETSY=false
