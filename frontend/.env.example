# Frontend environment (Vercel / local)
# Copy to frontend/.env.local for local overrides. Never commit real secrets.

# Production API root — e.g. https://your-api.onrender.com/api
# Leave unset locally to use Vite proxy (/api → localhost:3001)
VITE_API_BASE_URL=

# Optional simple password gate (client-side only — not full auth)
VITE_APP_PASSWORD=

# Must match backend API_SECRET when that is set on Render
VITE_API_SECRET=
